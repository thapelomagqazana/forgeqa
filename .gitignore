marimo/_static/
marimo/_lsp/
__marimo__/

# Streamlit
.streamlit/secrets.toml

# =============================================================================
# ForgeQA - .gitignore
# =============================================================================
# This file ensures that only source code and documentation are tracked.
# Generated files, secrets, and environment-specific configuration are ignored.
# =============================================================================

