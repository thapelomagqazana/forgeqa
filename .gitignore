# -----------------------------------------------------------------------------
# Playwright & Browser Automation
# -----------------------------------------------------------------------------
# Playwright installs browsers in a cache directory (usually ~/.cache/ms-playwright)
# We don't track any browser binaries or test artifacts.
playwright-report/
test-results/
blob-report/
.playwright/
# Playwright traces and screenshots generated during local runs
traces/
screenshots/
videos/

# -----------------------------------------------------------------------------
# ForgeQA Framework Artifacts
# -----------------------------------------------------------------------------
# The default artifacts directory defined in forgeqa.toml
artifacts/
# Any run-specific output directories
run-*/
# JUnit XML and JSON reports
*.xml
results.json
summary.txt
*.jsonl

# -----------------------------------------------------------------------------
# Environment & Secrets
# -----------------------------------------------------------------------------
# Never commit actual environment files
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
credentials/
# Local configuration overrides
forgeqa.local.toml

